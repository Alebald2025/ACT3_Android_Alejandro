<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity_13">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/top_centro"
            android:layout_width="250dp"
            android:layout_height="80dp"
            android:background="@color/purple_500"
            android:layout_alignParentTop="true"
            android:layout_toLeftOf="@id/top_right"/>

        <View
            android:id="@+id/top_right"
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:background="#DD0067"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>

        <View
            android:id="@+id/centro_centro"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:background="#009688"
            android:layout_below="@id/top_centro"
            android:layout_alignParentRight="true"/>

        <View
            android:id="@+id/bott_iz"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:background="#FF9800"
            android:layout_below="@id/centro_centro"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"/>

        <View
            android:id="@+id/bott_der"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#DD0067"
            android:layout_alignTop="@id/bott_iz"
            android:layout_toRightOf="@id/bott_iz"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>